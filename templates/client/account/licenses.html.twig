{% extends '@Forge/client/layout.html.twig' %}

{% block forge_title %}{{ '@forge.account.title'|trans }}{% endblock %}
{% block forge_lead %}{{ '@forge.account.lead'|trans }}{% endblock %}
{% block forge_class %}forge-account{% endblock %}
{% block background %}whitey{% endblock %}

{% block forge_actions %}
    <p class="forge-balance{{ balance < 120 ? ' is-low' }}">
        <span>{{ '@forge.hours.balance'|trans }}</span>
        <strong>{{ balance|forge_hours }}</strong>
    </p>
{% endblock %}

{% block forge_body %}
{% if key %}
<section class="forge-key" role="alert">
    <h2><i class="fa-solid fa-key"></i> {{ '@forge.license.new_key'|trans({software: key.license.software.name}) }}</h2>
    <p>{{ '@forge.license.new_key_help'|trans }}</p>
    <pre class="forge-code"><code>{{ key.value }}</code></pre>
    <pre class="forge-code"><code>composer config http-basic.{{ app.request.host }} {{ key.license.findSeatOf(app.user).email }} {{ key.value }}</code></pre>
</section>
{% endif %}

{#
 # Each licence once: its state; the seat the user holds, and its key; the
 # seats, when the licence is theirs to give - an e-mail each.
 #}
<section class="forge-section">
    <h2><i class="fa-solid fa-certificate"></i> {{ '@forge.account.licenses'|trans }}</h2>
    {% for license in licenses %}
    {% set mine = license.owner and license.owner.id == app.user.id %}
    {% set seat = license.findSeatOf(app.user) %}
    <article class="forge-license" id="licence-{{ license.id }}">
        <header>
            <h3><a href="{{ path('forge_software', {slug: license.software.slug}) }}">{{ license.software.name }}</a></h3>
            <span class="forge-badge is-{{ license.valid ? 'active' : license.status.value }}">{{ ('@forge.license.statuses.' ~ (license.valid ? 'active' : (license.status.value == 'active' ? 'expired' : license.status.value)))|trans }}</span>
            <p class="forge-meta">
                {{ '@forge.license.expires'|trans }} : {{ license.expiresAt ? license.expiresAt|format_date('medium') : '@forge.license.never'|trans }}
                · {{ '@forge.license.updates'|trans }} : {{ license.updatesUntil ? license.updatesUntil|format_date('medium') : '@forge.license.all'|trans }}
                · {{ '@forge.seat.count'|trans({taken: license.seatsTaken, seats: license.seats}) }}
            </p>
        </header>

        {% if seat %}
        <div class="forge-license-mine">
            <span><i class="fa-solid fa-user-check"></i> {{ '@forge.seat.yours'|trans({email: seat.email}) }}</span>
            <span>{{ '@forge.license.key'|trans }} : {% if seat.hasKey %}<code>{{ seat.keyPrefix }}…</code>{% else %}—{% endif %}</span>
            {% if license.valid %}
            <form method="post" action="{{ path('forge_license_rekey', {id: license.id}) }}" data-confirm="{{ seat.hasKey ? '@forge.license.rekey_confirm'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('forge_license_' ~ license.id) }}">
                <button type="submit" class="forge-link">{{ (seat.hasKey ? '@forge.license.rekey' : '@forge.license.generate')|trans }}</button>
            </form>
            {% endif %}
        </div>
        {% include '@Forge/client/account/_machines.html.twig' with {seat: seat, license: license} %}
        {% endif %}

        {% if mine %}
        <ul class="forge-seats">
            {% for holder in license.holders %}
            <li>
                <span>{{ holder.email }}</span>
                <span class="forge-meta">{{ holder.user ? '@forge.seat.linked'|trans : '@forge.seat.waiting'|trans }}{{ holder.hasKey ? ' · ' ~ '@forge.seat.has_key'|trans }} · {{ '@forge.machine.count'|trans({taken: holder.activations|length, machines: license.machinesPerSeat}) }}</span>
                <form method="post" action="{{ path('forge_license_seat_take_back', {id: license.id, seat: holder.id}) }}" data-confirm="{{ '@forge.seat.take_back_confirm'|trans({email: holder.email}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('forge_license_seats_' ~ license.id) }}">
                    <button type="submit" class="forge-link">{{ '@forge.seat.take_back'|trans }}</button>
                </form>
            </li>
            {% endfor %}
        </ul>
        {% if license.valid and license.seatsLeft > 0 %}
        <form class="forge-seat-give" method="post" action="{{ path('forge_license_seat_give', {id: license.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('forge_license_seats_' ~ license.id) }}">
            <label for="seat-{{ license.id }}">{{ '@forge.seat.give_label'|trans({left: license.seatsLeft}) }}</label>
            <input id="seat-{{ license.id }}" type="email" name="email" required placeholder="{{ '@forge.seat.placeholder'|trans }}" autocomplete="off">
            <button type="submit" class="forge-btn">{{ '@forge.seat.give'|trans }}</button>
        </form>
        {% endif %}
        {% endif %}
    </article>
    {% else %}
    <p class="forge-empty">{{ '@forge.account.no_license'|trans }} <a href="{{ path('forge_downloads') }}">{{ '@forge.downloads.title'|trans }}</a></p>
    {% endfor %}
</section>

{% if quotes|length %}
<section class="forge-section" id="devis">
    <h2><i class="fa-solid fa-file-invoice"></i> {{ '@forge.account.quotes'|trans }}</h2>
    <ul class="forge-list">
    {% for quote in quotes|filter(q => q.status.value not in ['requested', 'draft']) %}
        <li><a href="{{ path('forge_quote', {token: quote.token}) }}">{{ quote.reference }} · {{ quote.title }}</a>
            <span class="forge-badge is-{{ quote.status.value }}">{{ ('@forge.quote.status.' ~ quote.status.value)|trans }}</span>
            <span class="forge-meta">{{ quote.total|forge_money(quote.currency) }}</span></li>
    {% endfor %}
    {% for quote in quotes|filter(q => q.status.value in ['requested', 'draft']) %}
        <li>{{ quote.reference }} · {{ quote.title }} <span class="forge-badge">{{ ('@forge.quote.status.' ~ quote.status.value)|trans }}</span></li>
    {% endfor %}
    </ul>
</section>
{% endif %}

<section class="forge-section" id="heures">
    <h2><i class="fa-solid fa-hourglass-half"></i> {{ '@forge.account.hours'|trans }}</h2>
    <div class="forge-table-wrap">
    <table class="forge-table">
        <tbody>
        {% for line in history %}
            <tr>
                <td>{{ line.createdAt|format_date('medium') }}</td>
                <td>{{ ('@forge.hours.reason.' ~ line.reason.value)|trans }}{% if line.note %} — {{ line.note }}{% endif %}{% if line.timeEntry %} — {{ line.timeEntry.note }}{% endif %}</td>
                <td class="num {{ line.minutes < 0 ? 'is-debit' : 'is-credit' }}">{{ line.minutes > 0 ? '+' }}{{ line.minutes|forge_hours }}</td>
            </tr>
        {% else %}
            <tr><td class="forge-empty">{{ '@forge.account.no_hours'|trans }} <a href="{{ path('forge_shop') }}">{{ '@forge.shop.title'|trans }}</a></td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</section>

{% if hub_tokens|default([])|length %}
<section class="forge-section" id="editeurs">
    <h2><i class="fa-solid fa-plug"></i> {{ '@forge.account.editors'|trans }}</h2>
    <p class="forge-meta">{{ '@forge.account.editors_help'|trans }}</p>
    <ul class="forge-list">
    {% for token in hub_tokens %}
        <li>
            <code>{{ token.tokenPrefix }}…</code>
            <span class="forge-meta">{{ '@forge.account.editor_linked'|trans({date: token.createdAt|format_date('medium')}) }} · {{ token.lastUsedAt ? '@forge.account.editor_used'|trans({date: token.lastUsedAt|format_date('medium')}) : '@forge.account.editor_unused'|trans }}</span>
            <form method="post" action="{{ path('forge_account_hub_token_revoke', {id: token.id}) }}" data-confirm="{{ '@forge.account.editor_revoke_confirm'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('forge_hub_token_' ~ token.id) }}">
                <button type="submit" class="forge-link">{{ '@forge.account.editor_revoke'|trans }}</button>
            </form>
        </li>
    {% endfor %}
    </ul>
</section>
{% endif %}

{% if downloads|length %}
<section class="forge-section">
    <h2><i class="fa-solid fa-download"></i> {{ '@forge.account.downloads'|trans }}</h2>
    <ul class="forge-list">
    {% for download in downloads %}
        <li>{{ download.artifact.release }} <span class="forge-meta">{{ download.downloadedAt|format_datetime('medium', 'short') }} · {{ download.channel }}</span></li>
    {% endfor %}
    </ul>
</section>
{% endif %}
{% endblock %}
