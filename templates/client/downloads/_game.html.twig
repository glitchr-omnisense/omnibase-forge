{#
 # A game's head on its page: played in the page when its newest version has a
 # WebGL build the visitor may play (free, or covered by their licence) - the
 # build loads only when Play is pressed (bundles/forge/js/play.js frames
 # forge_play; without JavaScript the link opens it on its own) -, then its
 # trailer and its screenshots. Its builds per platform are under each version.
 #}
{% set playable = null %}
{% for release in software.releases|filter(r => r.published and r.artifact('webgl')) %}
    {% if playable is null %}{% set playable = release %}{% endif %}
{% endfor %}
{% set may_play = playable and (software.free or is_granted('ROLE_STAFF') or licenses|filter(l => l.covers(playable))|length > 0) %}
{% set poster = software.screenshots|first ?: software.image %}

<link rel="stylesheet" href="{{ asset('bundles/forge/css/games.css') }}">
<script src="{{ asset('bundles/forge/js/play.js') }}" defer></script>

<section class="forge-game" aria-label="{{ software.name }}">
    {% if playable %}
    <div class="forge-play" data-forge-play>
        <div class="forge-play-stage" data-forge-play-stage{% if poster %} style="background-image: url('{{ poster|e('css') }}')"{% endif %}>
            {% if may_play %}
            <a class="forge-play-start" href="{{ path('forge_play', {slug: software.slug, version: playable.version}) }}/" target="_blank" rel="noopener" data-forge-play-start>
                <i class="fa-solid fa-play" aria-hidden="true"></i> {{ '@forge.game.play'|trans }}
            </a>
            {% else %}
            <span class="forge-play-start is-locked"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{ '@forge.game.locked'|trans }}</span>
            {% endif %}
        </div>
        <p class="forge-play-bar">
            <span class="forge-meta">{{ playable.version }} · {{ '@forge.game.play_help'|trans }}</span>
            {% if may_play %}
            <button type="button" class="forge-link" data-forge-play-fullscreen hidden><i class="fa-solid fa-expand" aria-hidden="true"></i> {{ '@forge.game.fullscreen'|trans }}</button>
            <a class="forge-link" href="{{ path('forge_play', {slug: software.slug, version: playable.version}) }}/" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{ '@forge.game.open'|trans }}</a>
            {% endif %}
        </p>
    </div>
    {% endif %}

    {% if software.trailer %}
    <figure class="forge-game-trailer">
        <video controls preload="none"{% if poster %} poster="{{ poster }}"{% endif %} src="{{ software.trailer }}"></video>
        <figcaption>{{ '@forge.game.trailer'|trans }}</figcaption>
    </figure>
    {% endif %}

    {% if software.screenshots|length %}
    <h2>{{ '@forge.game.screenshots'|trans }}</h2>
    <ul class="forge-game-screenshots">
        {% for screenshot in software.screenshots %}
        <li><a href="{{ screenshot }}" target="_blank" rel="noopener"><img src="{{ screenshot }}" alt="{{ software.name }} {{ loop.index }}" loading="lazy"></a></li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
