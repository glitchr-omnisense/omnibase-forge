{
    "name": "omnibase/forge",
    "type": "symfony-bundle",
    "description": "Software forge for base-bundle: releases built from git tags, free and licensed downloads, a private Composer repository, a Unity registry (its documents written by omnisense/omnihub), client projects with a shared board, prepaid support hours and quotes - paid through base-bundle-market",
    "keywords": [
        "symfony",
        "forge",
        "licensing",
        "downloads",
        "composer",
        "support",
        "time-tracking",
        "quotes",
        "git"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnibase-forge",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Forge\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Forge\\": "./tests"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "doctrine/orm": "^2.15|^3.0",
        "git/git-bundle": "1.x-dev",
        "omnibridge/symfony": "1.x-dev",
        "omnisense/omnibase": "3.0.*-dev || 4.0.*-dev || 5.0.*-dev",
        "omnisense/omnihub": "1.x-dev",
        "omnibase/admin": "dev-main",
        "omnibase/marketplace": "dev-main",
        "omnisense/omnistate": "1.x-dev",
        "omnistate/annuaire-entreprises": "1.x-dev",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/lock": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0"
    },
    "suggest": {
        "ext-git2": "Required by git/git-bundle to read repositories (releases, the project dashboard's history)",
        "omnisense/omnitrade": "^1.1 with a provider that saves payment methods (omnitrade/stripe ^1.1): one-click purchases from Forge Store and Forge Hub (forge.hub.payment_gateway, docs/hub.md)",
        "symfony/http-client": "Reads the pipelines' runs from GitHub Actions (Pipeline\\GithubActionsSource)",
        "symfony/yaml": "The stages of a GitHub Actions run, from its workflow file's needs"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev",
        "allow-plugins": {
            "omnibridge/composer": true,
            "php-http/discovery": true
        }
    }
}
